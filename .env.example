# AYUSH combined workspace: share the exact DATA_ROOT and AYUSH_SECRET with Ayurveda/Yoga.
# Extract Unani beside the Ayurveda and Yoga project folders as described in COMBINED_WORKSPACE_SETUP.md.
AYUSH_SECRET=   # Leave blank to load the shared secret from AYUSH_SHARED_DATA/ayush.secret
PORT_BASE=5300
DATA_ROOT=../../AYUSH_SHARED_DATA

# Shared services are hosted once by Ayurveda (PORT_BASE=5100).
PLATFORM_PORT=5101
PLATFORM_URL=http://127.0.0.1:5101
CLINICAL_PORT=5107
CLINICAL_URL=http://127.0.0.1:5107
LONGITUDINAL_PORT=5108
LONGITUDINAL_URL=http://127.0.0.1:5108
INTEGRATIONS_PORT=5109
INTEGRATIONS_URL=http://127.0.0.1:5109
BUS_PORT=5110
BUS_URL=http://127.0.0.1:5110

OTP_CODE=                # EMPTY = random OTP per request. Set e.g. 123456 only for fixed demo/test code
OTP_SHOW=1               # Local demo only: show OTP on screen/terminal
FACE_THRESHOLD=0.5
FACE_REQUIRED=1
ADMIN_INVITE=AYUSH-ADMIN-2026
ACCESS_TOKEN_MINUTES=60
DEMO_AADHAAR_HINT=1
SEED_DEMO=0              # Shared Platform is started by Ayurveda; do not seed a second platform
CORS_ORIGIN=http://localhost:5171,http://127.0.0.1:5171,http://localhost:5172,http://127.0.0.1:5172,http://localhost:5173,http://127.0.0.1:5173
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
TRANSLATE_URL=
TRANSLATE_KEY=
ANTHROPIC_API_KEY=       # Optional; keep private
ANTHROPIC_MODEL=

# Local demonstration only. Do not expose demo OTP settings publicly.
VITE_PLATFORM_URL=http://127.0.0.1:5300/v1
VITE_API_URL=http://127.0.0.1:5300/v1/unani
