# Copy the values into your local .env (do not commit real credentials).
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Optional; defaults to required TLS for Supabase
PGSSL=true
# Source SQLite data folder. Defaults to ../shared-database-template
SQLITE_ROOT=../shared-database-template
