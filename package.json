{
  "name": "ayush-unani-service-demo",
  "version": "3.0.0",
  "private": true,
  "description": "Unani healthcare application with shared AYUSH platform and Unani-specific clinical modules",
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:frontend": "node scripts/dev-frontends.js",
    "start": "node scripts/dev-all.js --no-frontend",
    "build": "npm run build:frontends",
    "health": "node scripts/health.js",
    "test": "node scripts/unani-smoke-test.js",
    "test:isolation": "node scripts/unani-smoke-test.js",
    "check": "node scripts/check-syntax.js",
    "seed": "node scripts/seed-demo.js",
    "models": "node scripts/copy-models.js",
    "postinstall": "node scripts/copy-models.js",
    "test:reader": "node scripts/reader-test.js",
    "dev:frontends": "node scripts/dev-frontends.js",
    "build:frontends": "npm run build:unani",
    "prepare:data": "node scripts/prepare-shared-data.js",
    "dev:unani": "vite --config frontend-apps/unani/vite.config.js",
    "build:unani": "vite build --config frontend-apps/unani/vite.config.js"
  },
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.3",
    "multer": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "ffmpeg-static": "^5.2.0",
    "pino": "^9.0.0"
  }
}
