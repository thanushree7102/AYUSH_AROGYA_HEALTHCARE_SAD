# Copy to .env (never commit .env).
AYUSH_SECRET=   # Leave blank; shared secret is stored once in AYUSH_SHARED_DATA/ayush.secret
PORT_BASE=5100
DATA_ROOT=../../AYUSH_SHARED_DATA
EVENT_BUS_DATA_ROOT=./local-data/event-bus
INTEGRATIONS_DATA_ROOT=./local-data/integrations
OTP_CODE=                # EMPTY = random OTP per request. Set e.g. 123456 only for fixed demo/test code
OTP_SHOW=1               # 1 = local demo: show OTP on screen. 0 = hide
FACE_THRESHOLD=0.5
FACE_REQUIRED=1
ADMIN_INVITE=AYUSH-ADMIN-2026
ACCESS_TOKEN_MINUTES=60
DEMO_AADHAAR_HINT=1
SEED_DEMO=1
CORS_ORIGIN=http://localhost:5171,http://127.0.0.1:5171
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
TRANSLATE_URL=
TRANSLATE_KEY=
ANTHROPIC_API_KEY=       # Optional: enables vision OCR for handwriting / Hindi (keep private)
ANTHROPIC_MODEL=         # Optional: model name supported by your API account

# LOCAL DEMO ONLY: OTP requests have no resend cooldown or hourly cap.
# Do not expose this configuration to the public internet or use it in production.

VITE_PLATFORM_URL=http://127.0.0.1:5100/v1
VITE_API_URL=http://127.0.0.1:5100/v1/ayurveda
